{{!
    @template local_dictionaries/manage

    Lists the reference dictionary domains. Forms are rendered server-side via moodleform.

    Context variables required for this template:
    * hasdomains - whether the list has rows
    * domains - list of domains: shortname, name, description, visibility (text), itemcount,
      timemodified (text), editurl

    Example context (json):
    {
        "hasdomains": true,
        "domains": [
            {
                "shortname": "diretoria",
                "name": "Diretoria",
                "description": "Regional boards",
                "visibility": "Any logged-in user except guests",
                "itemcount": 12,
                "timemodified": "2 April 2026",
                "editurl": "https://example.com/local/dictionaries/manage.php?edit=diretoria"
            }
        ]
    }
}}
<h3 class="h5 mt-4">{{#str}}existingdomains, local_dictionaries{{/str}}</h3>

{{#hasdomains}}
<table class="table table-striped local-dictionaries-domains">
    <thead>
        <tr>
            <th scope="col">{{#str}}shortname, local_dictionaries{{/str}}</th>
            <th scope="col">{{#str}}name, local_dictionaries{{/str}}</th>
            <th scope="col">{{#str}}domainvisibility, local_dictionaries{{/str}}</th>
            <th scope="col">{{#str}}itemcount, local_dictionaries{{/str}}</th>
            <th scope="col">{{#str}}timemodified, local_dictionaries{{/str}}</th>
            <th scope="col">{{#str}}actions, local_dictionaries{{/str}}</th>
        </tr>
    </thead>
    <tbody>
        {{#domains}}
        <tr>
            <td>{{shortname}}</td>
            <td>
                {{name}}
                {{#description}}<div class="small">{{description}}</div>{{/description}}
            </td>
            <td>{{visibility}}</td>
            <td>{{itemcount}}</td>
            <td>{{timemodified}}</td>
            <td><a href="{{editurl}}">{{#str}}editdomain, local_dictionaries, {{shortname}}{{/str}}</a></td>
        </tr>
        {{/domains}}
    </tbody>
</table>
{{/hasdomains}}

{{^hasdomains}}
<div class="alert alert-info" role="alert">{{#str}}nodomains, local_dictionaries{{/str}}</div>
{{/hasdomains}}
